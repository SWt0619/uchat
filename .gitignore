# ===== 运行/构建产物（不入库）=====
/target/
/backup/
/uchat.jar

# ===== 运行时数据（含用户账号哈希、聊天记录、上传文件）=====
/data/
/logs/

# ===== 内置便携 JDK（约 289 MB，属"分发素材"，不入库）=====
/java/

# ===== 密钥库：含私钥，不入库 =====
# 新机器上克隆后需单独拷贝 keystore.p12（或重新生成自签证书），否则 HTTPS 起不来。
# 口令同理：存 keystore.pwd / 用户环境变量 UCHAT_KEYSTORE_PWD，绝不入库。
/keystore.p12
/keystore.pwd

